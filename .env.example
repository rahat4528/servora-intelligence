# ==============================================================================
# SERVORA INTELLIGENCE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the application:
#   copy .env.example .env (Windows) or cp .env.example .env (Linux/macOS)
# All configuration variables strictly adhere to the SERVORA_ prefix convention.
# ==============================================================================

# Application Environment
SERVORA_NODE_ENV=development
SERVORA_PORT=4000
SERVORA_FRONTEND_URL=http://localhost:3000
SERVORA_BACKEND_URL=http://localhost:4000

# PostgreSQL Database (with pgvector)
SERVORA_DATABASE_URL=postgresql://servora_user:servora_password@localhost:5432/servora_dev?schema=public

# Redis & BullMQ
SERVORA_REDIS_HOST=localhost
SERVORA_REDIS_PORT=6379
SERVORA_REDIS_PASSWORD=

# S3-Compatible Object Storage (MinIO)
SERVORA_STORAGE_ENDPOINT=localhost
SERVORA_STORAGE_PORT=9000
SERVORA_STORAGE_USE_SSL=false
SERVORA_STORAGE_ACCESS_KEY=servora_minio_user
SERVORA_STORAGE_SECRET_KEY=servora_minio_password
SERVORA_STORAGE_BUCKET=servora-documents

# Security & Authentication
SERVORA_JWT_SECRET=servora-dev-jwt-secret-min-32-chars-replace-in-production
SERVORA_JWT_EXPIRES_IN=7d

# LLM Provider Abstraction
# Default mode is 'mock' so application boots and tests pass without external API keys.
# Switch to 'gemini' or 'openai' when API credentials are provided.
SERVORA_LLM_PRIMARY_PROVIDER=mock
SERVORA_LLM_FALLBACK_PROVIDER=mock
SERVORA_GEMINI_API_KEY=
SERVORA_GEMINI_MODEL=gemini-2.5-flash
SERVORA_OPENAI_API_KEY=
SERVORA_OPENAI_MODEL=gpt-4o-mini
SERVORA_EMBEDDING_PROVIDER=mock
SERVORA_EMBEDDING_MODEL=text-embedding-004

# CalQuick Order & Courier Integration
# Currently in 'mock' mode per ADR-003 until upstream API credentials are provided.
SERVORA_CALQUICK_ADAPTER_MODE=mock
SERVORA_CALQUICK_BASE_URL=
SERVORA_CALQUICK_API_KEY=

# Tenant AI Governance & Safety Limits
SERVORA_MAX_DAILY_BUDGET_USD=50.00
SERVORA_MAX_MONTHLY_BUDGET_USD=1000.00
SERVORA_MAX_TOKENS_PER_CONVERSATION=8000
SERVORA_MAX_TOOL_CALLS_PER_CONVERSATION=5

# Logging
SERVORA_LOG_LEVEL=info

